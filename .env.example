# Spring reads this as a Java properties file: KEY=value, without surrounding quotes.
# Copy to .env and fill in the database password. Do not commit .env.
ZAZA_DB_URL=jdbc:postgresql://localhost:5432/zaza
ZAZA_DB_USER=admin
ZAZA_DB_PASSWORD=
ZAZA_BIND_ADDRESS=127.0.0.1
ZAZA_PORT=8080
ZAZA_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Private local image storage. Use an absolute path for external storage directories.
ZAZA_IMAGE_DIRECTORY=.local-images

# Private local video storage and processing tools
ZAZA_VIDEO_DIRECTORY=.local-videos
ZAZA_FFMPEG=.tools/ffmpeg/bin/ffmpeg.exe
ZAZA_FFPROBE=.tools/ffmpeg/bin/ffprobe.exe

# Encrypted document vault. Run scripts/initialize-document-key.ps1 locally.
# Key ring format: key-id:base64-256-bit-key,another-key-id:base64-256-bit-key
# Keep old key IDs available when rotating. Never commit real key material.
ZAZA_DOCUMENT_KEYS=
ZAZA_DOCUMENT_ACTIVE_KEY_ID=
ZAZA_DOCUMENT_DIRECTORY=.local-documents
ZAZA_DOCUMENT_UPLOADS_PER_HOUR=20
